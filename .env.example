# Public website URL used when generating table QR codes. Set this before deployment.
VITE_PUBLIC_APP_URL=https://your-serveiq-domain.example

# Use VITE_DATA_MODE=supabase after running supabase/schema.sql and creating staff profiles.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay TEST key ID only. It is safe to expose this public key in the frontend.
# Keep the matching key secret and webhook secret exclusively in Supabase Edge Function secrets.
VITE_RAZORPAY_KEY_ID=
